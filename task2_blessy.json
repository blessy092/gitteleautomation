      "id": "2da7581c-3539-4cb4-a588-d1a3984b857a",
      "name": "Fetch GitHub Repos",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        224,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "\n// The repos endpoint returns a bare array, which n8n splits into one item per repo\nconst repos = $input.all()\n  .map(item => item.json)\n  .filter(repo => repo && repo.name);\n\nif (repos.length === 0) {\n  throw new Error(\"No repositories found\");\n}\n\n// Sort by stars (highest first)\nconst topFive = repos\n  .sort((a, b) =>\n    b.stargazers_count - a.stargazers_count\n  )\n  .slice(0, 5);\n\n// Select the first repository for enrichment\nconst featured = {\n  name: topFive[0].name,\n  full_name: topFive[0].full_name,\n  owner: topFive[0].owner.login,\n  repo: topFive[0].name,\n  stars: topFive[0].stargazers_count,\n  language: topFive[0].language,\n  url: topFive[0].html_url\n};\n\n// Return one item containing both lists\nreturn [{\n  json: {\n    topFive: topFive.map(repo => ({\n      name: repo.full_name,\n      stars: repo.stargazers_count,\n      language: repo.language,\n      url: repo.html_url\n    })),\n    featured\n  }\n}];\n"
      },
      "id": "628c309f-c9a3-4f88-aea1-23965d3daed4",
      "name": "Transform Top Five",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{$json.featured.owner}}/{{$json.featured.repo}}/readme",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        128,
        256
      ],
      "id": "9dfe05cc-15f4-4600-ae9d-ed9b2522b275",
      "name": "HTTP Request1"
    },
    {
      "parameters": {
        "jsCode": "\nconst readme = $input.first().json;\n\n// Retrieve data from the earlier Code node\nconst original = $('Transform Top Five').first().json;\n\nconst topFive = original.topFive;\nconst featured = original.featured;\n\n// Prepare repository list\nconst repositoryList = topFive.map((repo, index) => {\n  return `${index + 1}. ${repo.name}\n⭐ Stars: ${repo.stars.toLocaleString()}\nLanguage: ${repo.language || \"Not specified\"}\nLink: ${repo.url}`;\n}).join(\"\\n\\n\");\n\n// Prepare Telegram message\nconst digestText = `\n☀️ GITHUB MORNING BRIEF\n\nTop 5 Python Repositories\n\n${repositoryList}\n\n🔥 FEATURED REPOSITORY\n\n${featured.full_name}\n\n⭐ Stars: ${featured.stars}\n\n📖 README:\n${readme.html_url || readme.download_url || \"Not available\"}\n\nGenerated by n8n Automation\n`;\n\nreturn [{\n  json: {\n    featured,\n    topFive,\n    readme: {\n      url: readme.html_url || readme.download_url,\n      size: readme.size\n    },\n    digestText\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
